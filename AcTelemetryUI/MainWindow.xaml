<Window x:Class="AcTelemetryUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assetto Corsa Telemetry Dashboard" 
        Height="450" Width="750"
        Background="#121212" Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <!-- Rozdělení okna na 3 řádky: Stavový řádek, Hlavní budíky, Pedály -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. ŘÁDEK: Stav připojení -->
        <TextBlock x:Name="StatusText" 
                   Grid.Row="0"
                   Text="Waiting.." 
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="#FFA500" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- 2. ŘÁDEK: Rychlost, Zařazený stupeň, Otáčky (3 sloupce) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Levý sloupec: Rychlost -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="" FontSize="14" Foreground="#888888" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SpeedText" Text="0" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="km/h" FontSize="16" Foreground="#888888" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Střední sloupec: Kvalt -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="12" Padding="35,15" Margin="30,0,30,0" VerticalAlignment="Center" Height="152">
                <StackPanel Margin="0,0,0,35">
                    <TextBlock x:Name="GearText" Text="N" FontSize="80" FontWeight="Bold" Height="111"/>
                </StackPanel>
            </Border>

            <!-- Pravý sloupec: Otáčky (RPM) -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="" FontSize="14" Foreground="#888888" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RpmText" Text="0" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="RPM" FontSize="16" Foreground="#888888" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 3. ŘÁDEK: Ukazatele plynu a brzdy -->
        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <!-- Plyn -->
            <TextBlock Text="THROTTLE" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
            <ProgressBar x:Name="GasBar" Height="22" Minimum="0" Maximum="100" Value="0" 
                         Foreground="#00E676" Background="#2A2A2A" BorderThickness="0" Margin="0,0,0,12"/>

            <!-- Brzda -->
            <TextBlock Text="BREAK" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
            <ProgressBar x:Name="BrakeBar" Height="22" Minimum="0" Maximum="100" Value="0" 
                         Foreground="#FF1744" Background="#2A2A2A" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>